  const found = tasks.filter(({ task }) => task.id === taskId);
  if (found.length === 0) {
    refuse(`\u63D0\u4EA4\u6D88\u606F\u91CC\u7684\u4EFB\u52A1 id "${taskId}" \u627E\u4E0D\u5230\u5BF9\u5E94\u7684\u4EFB\u52A1\u8BB0\u5F55\uFF08.dsh/task-<id>.json\uFF09`);
  }
  if (found.length > 1) refuse(`\u4EFB\u52A1 id "${taskId}" \u5728\u591A\u4E2A\u5DE5\u4F5C\u533A\u91CD\u590D\uFF1B\u8BF7\u5148\u6D88\u9664\u6B67\u4E49`);
  state = found[0].task;
} else {
  state = pickTask(tasks, currentBranch());
}
if (!state) {
  refuse("\u5F53\u524D\u5206\u652F\u6CA1\u6709\u53EF\u63D0\u4EA4\u7684 dev_task \u4EFB\u52A1\u2014\u2014\u8BF7\u5148\u5EFA\u7ACB\u4EFB\u52A1\uFF0C\u6216\u5728\u63D0\u4EA4\u6D88\u606F\u5F00\u5934\u5199\u660E\u3010\u4EFB\u52A1ID\u3011");
}
if (state.completed !== void 0) refuse("\u6B64\u4EFB\u52A1\u5DF2\u5F52\u6863\uFF0C\u4EC5\u53EF\u67E5\u770B\uFF1B\u8BF7\u65B0\u5EFA\u4EFB\u52A1\u540E\u63D0\u4EA4");
var branch = currentBranch();
if (!branch || branch === "HEAD" || state.branch !== branch) {
  refuse(`\u4EFB\u52A1 ${state.id} \u8BB0\u5F55\u7684\u5206\u652F\u662F ${state.branch}\uFF0C\u5F53\u524D Git \u5206\u652F\u662F ${branch || "\u672A\u77E5"}\uFF1B\u8BF7\u5207\u56DE\u4EFB\u52A1\u5206\u652F`);
}
if (state.flow?.hash !== void 0 && hashConfig(state.flow.config) !== state.flow.hash) {
  refuse(`\u4EFB\u52A1 ${state.id} \u7684\u6D41\u7A0B\u5FEB\u7167 hash \u4E0D\u5339\u914D\u2014\u2014task \u8BB0\u5F55\u5728\u521B\u5EFA\u540E\u88AB\u6539\u52A8\u8FC7\uFF0C\u4FEE\u590D\u6216\u91CD\u5EFA\u4EFB\u52A1\u540E\u518D\u63D0\u4EA4`);
}
var executionProblem = taskExecutionProblem(state);
if (executionProblem) refuse(executionProblem);
var config;
if (state.flow !== void 0 && state.flow.config !== void 0) {
  config = state.flow.config;
} else {
  refuse("\u6B64\u4EFB\u52A1\u7F3A\u5C11\u6D41\u7A0B\u5FEB\u7167\uFF0C\u8BF7\u91CD\u65B0\u521B\u5EFA\u4EFB\u52A1\u540E\u63D0\u4EA4");
}
var verdict = validateCommitMessage(message, config);
if (!verdict.ok) {
  refuse(verdict.errors?.[0] ?? "commit summary does not match the configured pattern");
}
if (config.requirement_review) {
  if (!requirementConfirmed(state, config)) refuse("\u5F53\u524D\u9700\u6C42\u7248\u672C\u5C1A\u672A\u7531\u7528\u6237\u786E\u8BA4");
  const doc = state.requirements.document, workspace2 = state.root ?? cwd;
  const documentPath = import_node_path2.default.resolve(workspace2, doc.path);
  const outside = (file) => {
    const rel = import_node_path2.default.relative(import_node_fs2.default.realpathSync(workspace2), file);
    return rel.startsWith("..") || import_node_path2.default.isAbsolute(rel);
  };
  try {
    if (outside(import_node_fs2.default.realpathSync(documentPath)) || hashText(import_node_fs2.default.readFileSync(documentPath, "utf8")) !== doc.hash) refuse("\u9700\u6C42\u6587\u6863\u5DF2\u53D8\u5316\uFF1B\u8BF7\u4FEE\u8BA2\u5E76\u91CD\u65B0\u786E\u8BA4");
  } catch {
    refuse("\u9700\u6C42\u6587\u6863\u65E0\u6CD5\u6838\u5BF9\uFF1B\u8BF7\u4FEE\u8BA2\u5E76\u91CD\u65B0\u786E\u8BA4");
  }
}
var checkpoint = commitCheckpoint(state, config);
if (!checkpoint.allowed) {
  refuse((checkpoint.reason ?? "commit checkpoint rejected") + "\uFF08\u5F53\u524D\u9636\u6BB5: " + state.stage + "\uFF09");
}
var groupHashes = state.verification_version ? Object.fromEntries(Object.values(state.verification_groups ?? {}).map((group) => [group.id, scopeHash({ ...state, files: groupInputs(state, group) }, state.root ?? cwd, true)])) : void 0;
var evidence = verificationEvidenceBlockers(state, config, scopeHash(state, state.root ?? cwd), groupHashes);
evidence.push(...reviewEvidenceBlockers(state, scopeHash(state, state.root ?? cwd)));
if (evidence.length) refuse(evidence.join("; "));
if (state.sonar_policy?.enabled && ["\u4EE3\u7801\u5BA1\u6838", "\u5B8C\u6210"].includes(state.stage)) {
  const lastCommit = state.commits.findLast((entry) => entry.hash !== void 0)?.hash;
  const blockers = sonarCommitBlockers(state.sonar_policy, state.sonar_audit, scopeHash(state, state.root ?? cwd), lastCommit);
  if (state.sonar_policy.source === "ide-local" && state.sonar_audit) {
    const updated = lastLocalRuleUpdate(state.sonar_policy, state.root ?? cwd);
    const rulesHash = localRulesFingerprint(state.sonar_policy, state.root ?? cwd);
    if (updated && updated !== state.sonar_audit.rules_updated_at || rulesHash && rulesHash !== state.sonar_audit.rules_hash)
      blockers.push("project rule configuration changed; rerun sonar_check and review");
  }
  if (blockers.length) refuse(blockers.join("; "));
}
var workspace = state.root ?? cwd;
var entries = stagedEntries().map((entry) => {
  const absolute = import_node_path2.default.resolve(cwd, entry.path);
  const relativePath = import_node_path2.default.relative(workspace, absolute).replaceAll("\\", "/");
  return { ...entry, path: relativePath };
});
var scope = checkFileScope(state, entries.map((entry) => entry.path), config);
if (!scope.ok) {
  if (scope.noScope) {
    refuse("\u4EFB\u52A1\u6CA1\u6709\u58F0\u660E\u6587\u4EF6\u8303\u56F4\uFF08files \u4E3A\u7A7A\uFF09\u2014\u2014\u5148\u7528 dev_task operation=scope \u58F0\u660E\u672C\u4EFB\u52A1\u6D89\u53CA\u7684\u6587\u4EF6");
  }
  const described = scope.outside.map((outside) => {
    const entry = entries.find((candidate) => candidate.path === outside);
    return entry === void 0 ? outside : `${entry.status}	${outside}`;
  });
  refuse("\u63D0\u4EA4\u4E86\u4EFB\u52A1\u8303\u56F4\u4E4B\u5916\u7684\u6587\u4EF6: " + described.join(", "));
}
for (const entry of entries) {
  if (!isEngineMeta2(entry.path)) assertIndexMatchesWorktree(cwd, import_node_path2.default.relative(cwd, import_node_path2.default.resolve(workspace, entry.path)).replaceAll("\\", "/"));
}
var sensitive = riskyPaths(entries);
var riskyChanges = entries.filter((entry) => DEFAULT_RISK_POLICY.risky_operations.includes(entry.status[0] ?? "")).map((entry) => `${entry.status}	${entry.path}`);
if ((sensitive.length > 0 || riskyChanges.length > 0) && !riskVerified(state)) {
  refuse(
    "\u63D0\u4EA4\u89E6\u53CA\u654F\u611F\u8DEF\u5F84\u6216\u9AD8\u98CE\u9669\u64CD\u4F5C: " + [...sensitive, ...riskyChanges].join(", ") + " \u2014 \u8FD9\u7C7B\u53D8\u66F4\u8981\u6C42\u4EFB\u52A1\u58F0\u660E\u4E3A high_risk\uFF0C\u4E14\u9A8C\u8BC1\u5FC5\u987B\u662F\u771F\u5B9E\u547D\u4EE4\u56DE\u6267\uFF08exit 0\uFF09"
  );
}
process.exit(0);
