// src/project.ts
var TYPE_MARKERS = {
  node: ["package.json"],
  java: ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle"],
  python: ["pyproject.toml", "requirements.txt", "setup.py"],
  go: ["go.mod"],
  rust: ["Cargo.toml"]
};
var DEFAULT_RISK_POLICY = {
  // `.dsh/task-*.json` and `.dsh/eng.json` are protected by the snapshot hash and
  // the engine-meta exemption, not by this list; `.dsh/rules` / `.dsh/skills`
  // hold regular project content and stay committable by normal tasks.
  sensitive_paths: [".git", ".env", ".credentials.yaml", "credentials", "secrets"],
  risky_operations: ["D", "T"]
};
function isSensitivePath(path2) {
  const normalized = path2.replace(/\\/gu, "/").toLowerCase();
  const parts = normalized.split("/");
  if (DEFAULT_RISK_POLICY.sensitive_paths.some((prefix) => normalized === prefix || normalized.startsWith(`${prefix}/`))) return true;
  return parts.some((part) => /^\.env(?:\..+)?$|^\.envrc$/u.test(part) || /^\.?credentials(?:\.[^.]+)?$/u.test(part) || /^\.?secrets?(?:\.(?:json|ya?ml|toml|ini|properties))?$/u.test(part) || /\.(?:pem|p12|pfx|key)$/u.test(part) || /^(?:id_rsa|id_ed25519|id_ecdsa|id_dsa)(?:\.pub)?$/u.test(part));
}
var ALL_MARKERS = Object.values(TYPE_MARKERS).flat();

// src/sonar.ts
function unresolvedBlockingFindings(audit) {
  const approved = new Set((audit.dispositions ?? []).filter((entry) => entry.kind === "false_positive").map((entry) => entry.issue_key));
  return audit.blocking.filter((finding) => !approved.has(finding.key));
}
function localReviewGate(audit) {
  return unresolvedBlockingFindings(audit).length === 0 && !audit.uncovered_files?.length ? "OK" : "ERROR";
}
function sonarCommitBlockers(policy, audit, currentScopeHash, latestCommitHash) {
  if (!audit) return ["SonarQube audit is enabled but has not been run; call sonar_check in code review"];
  const problems = [];
  if (audit.scope_hash !== currentScopeHash) problems.push("SonarQube audit is stale after file changes; rerun the scan and sonar_check");
  if (policy.source === "ide-local") {
    if (localReviewGate(audit) !== "OK") problems.push("\u672C\u5730\u89C4\u5219\u5BA1\u6838\u5C1A\u6709\u672A\u89E3\u51B3\u95EE\u9898\u6216\u672A\u8986\u76D6\u6587\u4EF6");
    const unresolved = unresolvedBlockingFindings(audit);
    if (unresolved.length) problems.push(`${unresolved.length} medium/high SonarQube new-code findings remain`);
  } else {
    if (!latestCommitHash || audit.commit_hash !== latestCommitHash) {
      problems.push("SonarQube audit does not match the task's latest recorded commit");
    }
    if (audit.gate !== "OK") problems.push(`SonarQube Quality Gate is ${audit.gate}`);
    if (audit.blocking.length) problems.push(`${audit.blocking.length} medium/high SonarQube new-code findings remain`);
  }
  if (audit.uncovered_files?.length) problems.push(`\u672C\u5730\u89C4\u5219\u5BA1\u6838\u672A\u8986\u76D6 ${audit.uncovered_files.length} \u4E2A\u65B0\u589E\u4EE3\u7801\u6587\u4EF6`);
  return problems;
}

// src/evidence-gate.ts
function verificationEvidenceBlockers(state2, workflow, currentScopeHash, groupHashes2) {
  const needsVerification = verificationHeldStages(workflow).has(state2.stage) || workflow.transitions.some((edge) => edge.from === state2.stage && (edge.requires ?? []).includes("verified"));
  if (!needsVerification) return [];
  if (state2.verification_version) return groupEvidenceBlockers(state2, groupHashes2);
  if (!state2.verification.passed) return [];
  const receipt = state2.verification.receipt;
  if (!receipt) return ["verification has no command receipt; rerun verify on the current files"];
  if (receipt.scope_changed_during_run) return ["task files changed while verification ran; rerun tests"];
  if (!receipt.scope_hash || receipt.scope_hash !== currentScopeHash) {
    return ["verification is stale after file/scope changes; rerun verify on the current files"];
  }
  return [];
}
function reviewEvidenceBlockers(state2, currentScopeHash) {
  if (state2.review.outcome !== "pass") return [];
  if (state2.review.scope_hash !== currentScopeHash || (state2.verification_version ? state2.review.verification_key !== verificationKey(state2) : state2.review.verification_at !== state2.verification.receipt?.finished_at)) {
    return ["review is stale or has no content receipt; rerun review on the current verified files"];
  }
  return [];
}

