// src/engine.ts
function formatResourceRef(ref) {
  return `${ref.source}:${ref.name}`;
}
function artifactsForStage(stage, config2) {
  return config2.artifacts.filter((artifact) => artifact.stage === stage);
}
function todosBlockers(state2, config2) {
  if (state2.items.length === 0) return ["no implementation items"];
  const depth = config2?.review_depth ?? "two-stage";
  const blockers = [];
  for (const item of state2.items) {
    if (item.status !== "done") {
      blockers.push(`item "${item.id}" is ${item.status}`);
      continue;
    }
    if (item.review === void 0) {
      blockers.push(`item "${item.id}" is done but has no review`);
      continue;
    }
    if (item.review.spec?.outcome !== "pass") blockers.push(`item "${item.id}" spec review is not pass`);
    if (depth === "two-stage" && item.review.quality?.outcome !== "pass") {
      blockers.push(`item "${item.id}" quality review is not pass`);
    }
  }
  return blockers;
}
function guardSatisfied(guard, state2, config2) {
  switch (guard) {
    case "requirement_confirmation":
      return state2.requirement_confirmed;
    case "solution_confirmation":
      return state2.solution_confirmed;
    case "todos_done":
      return todosBlockers(state2, config2).length === 0;
    case "verified": {
      if (!state2.verification.passed) return false;
      if (config2.high_risk_requires_verification && state2.risk_level === "high_risk") {
        const receipt = state2.verification.receipt;
        return receipt !== void 0 && receipt.exit_code === 0 && !receipt.timed_out && !receipt.aborted;
      }
      return true;
    }
    case "review_passed":
      return state2.review.outcome === "pass";
    case "artifacts_present": {
      const required = artifactsForStage(state2.stage, config2);
      return required.every((artifact) => {
        const recorded = state2.artifacts[artifact.id];
        if (recorded === void 0) return false;
        return artifact.fields.every((field) => recorded[field] !== void 0 && recorded[field].trim() !== "");
      });
    }
  }
}
function validateCommitMessage(message2, config2) {
  if (config2.commit.message_pattern === "") return { ok: true };
  const re = new RegExp(config2.commit.message_pattern);
  if (re.test(message2)) return { ok: true };
  return {
    ok: false,
    errors: [`commit summary "${message2}" does not match ${config2.commit.message_hint}`]
  };
}
function verificationHeldStages(config2) {
  const held = /* @__PURE__ */ new Set();
  const queue = config2.transitions.filter((transition) => (transition.requires ?? []).includes("verified")).map((transition) => transition.to);
  while (queue.length > 0) {
    const stage = queue.shift();
    if (held.has(stage)) continue;
    held.add(stage);
    for (const transition of config2.transitions) {
      if (transition.from === stage && !held.has(transition.to)) queue.push(transition.to);
    }
  }
  return held;
}
function verificationBlockers(state2, config2) {
  if (state2.execution_version !== 1) return [];
  if (!verificationHeldStages(config2).has(state2.stage)) return [];
  const blockers = [];
  if (!state2.verification.passed) {
    blockers.push("this flow requires a passing verification at this stage, and the current verification is not passing");
  }
  if (config2.high_risk_requires_verification && state2.risk_level === "high_risk") {
    const receipt = state2.verification.receipt;
    if (receipt === void 0) {
      blockers.push("a high-risk task needs a real command receipt, and none is recorded");
    } else if (receipt.exit_code !== 0 || receipt.timed_out || receipt.aborted) {
      blockers.push("a high-risk task needs a command that exited 0 without timing out or aborting");
    }
  }
  return blockers;
}
function commitCheckpoint(state2, config2) {
  const { policy, checkpoints } = config2.commit;
  if (policy === "manual") {
    return { allowed: false, reason: "commit policy is manual \u2014 await an explicit user instruction" };
  }
  const verification = verificationBlockers(state2, config2);
  if (verification.length > 0) {
    return { allowed: false, reason: verification.join("; ") };
  }
  if (checkpoints.includes(state2.stage)) {
    const ready = config2.transitions.filter((transition) => transition.from === state2.stage).every((transition) => (transition.requires ?? []).every((g) => guardSatisfied(g, state2, config2)));
    if (!ready) {
      return { allowed: false, reason: "checkpoint stage reached but its outgoing guards are unmet" };
    }
    return { allowed: true, label: "TASK" };
  }
  if (policy === "item") {
    const done = state2.items.filter((item) => item.status === "done").length;
    if (done > 0) {
      return { allowed: true, label: `T${done}` };
    }
  }
  return { allowed: false, reason: "no commit is due at this stage under the current policy" };
}
function isEngineMeta(file) {
  return /^\.dsh\/(task-[^/]+\.json|eng\.json)$/.test(file);
}
function checkFileScope(state2, committing, config2) {
  if (!config2.commit.file_scope) return { ok: true, outside: [], noScope: false };
  if (state2.files.length === 0) return { ok: false, outside: [], noScope: true };
  const outside = committing.filter((file) => !state2.files.includes(file) && !isEngineMeta(file));
  return outside.length === 0 ? { ok: true, outside: [], noScope: false } : { ok: false, outside, noScope: false };
}

// src/workflows.ts
function bundled(skill, ...rules) {
  const ref = (name) => ({ source: "bundled", name });
  return { skill: ref(skill), rules: rules.map(ref) };
}
