      const info = import_node_fs2.default.lstatSync(target);
      if (!info.isFile()) refuse(`\u4EFB\u52A1\u8303\u56F4\u542B\u975E\u666E\u901A\u6587\u4EF6: ${file}`);
      const executable = process.platform === "win32" ? false : (info.mode & 73) !== 0;
