function requiredReviewPaths(plan) {
  const removed = new Set(plan.changes?.map((change) => change.path));
  return [.../* @__PURE__ */ new Set([
    ...plan.files.filter((file) => !removed.has(file)),
    ...(plan.changes ?? []).flatMap((change) => [change.baseline.git.path, ...change.baseline.before ? [change.baseline.before.path] : []])
  ])];
}

// src/reviewer-spec.ts
var REVIEW_PRESET = "task-engine-review";
var REVIEW_TOOLS = ["read", "glob", "grep", "structured_output"];
function validReviewPolicy(proof, childId, structured = false) {
  return !!proof && proof.version === 1 && proof.preset === REVIEW_PRESET && !!childId && proof.child_id === childId && Array.isArray(proof.tools) && proof.tools.includes("read") && (!structured || proof.tools.includes("structured_output")) && proof.tools.every((tool) => REVIEW_TOOLS.includes(tool));
}

// src/execution-plan.ts
function executionCoverageBlockers(state2) {
  if (!state2.delegation_version) return [];
  const owned = new Set(state2.items.flatMap((item) => item.execution_plan?.files ?? []));
  const missing = state2.files.filter((file) => !owned.has(file));
  return missing.length ? [`task files have no implementation-plan owner: ${missing.join(", ")}; plan all items before dispatch`] : [];
}
function hasFullReadCoverage(review, files) {
  return files.every((file) => review?.read_coverage?.some((entry) => entry.file === file && Number.isSafeInteger(entry.lines) && entry.lines >= 0));
}
function executionPlanKey(plan) {
  return JSON.stringify(plan);
}
function executionItemBlockers(state2, item) {
  if (!state2.delegation_version) return [];
  const plan = item.execution_plan;
  if (!plan) return [`item ${item.id}: call plan_execution before dispatch (record boundary, files, acceptance and reason)`];
  const blockers = [];
  if (!item.dispatch) blockers.push(`item ${item.id}: implementation has not been dispatched`);
  if (item.dispatch?.status && item.dispatch.status !== "completed") blockers.push(`item ${item.id}: implementation child is not completed`);
  if (item.review?.spec.outcome !== "pass" || state2.flow?.config.review_depth !== "single" && item.review.quality?.outcome !== "pass")
    blockers.push(`item ${item.id}: item review is missing or failed before done`);
  if (plan.review === "independent") {
    const review = item.independent_review;
    if (review?.status !== "completed" || !review.run_id || review.spec !== "pass" || review.quality !== "pass" || review.plan_key !== executionPlanKey(plan) || review.dispatch_at !== item.dispatch?.at || !validReviewPolicy(review.policy, review.run_id) || item.review?.independent_run_id !== review.run_id || !hasFullReadCoverage(review, requiredReviewPaths(plan)))
      blockers.push(`item ${item.id}: independent review is missing, failed or not accepted; run review_dispatch then review_item`);
  }
  return blockers;
}

// src/verification-state.ts
function receiptProblems(receipt) {
  const problems = [];
  if (receipt.sandbox?.runnerFailed) problems.push("ENVIRONMENT_BLOCKED: sandbox runner could not start; inspect the executor diagnostic");
  else if (receipt.sandbox?.denied) problems.push("ENVIRONMENT_BLOCKED: sandbox denied this command; inspect the denied path and request only the exact necessary command if needed");
  else if (receipt.exit_code !== 0 && /Cannot create resource output directory|spawn EPERM|access (?:is )?denied|拒绝访问/iu.test(`${receipt.stdout}
${receipt.stderr}`))
    problems.push("ENVIRONMENT_BLOCKED: filesystem or child-process access failed; do not repair permissions or widen the session automatically");
  if (receipt.timed_out) problems.push("TEST_TIMEOUT: command exceeded its execution limit");
  if (receipt.aborted) problems.push("TEST_CANCELLED: command did not finish");
  if (receipt.exit_code !== 0) problems.push(`TEST_COMMAND_FAILED: exit code ${receipt.exit_code}; inspect stdout/stderr before retrying`);
  if (receipt.scope_changed_during_run) problems.push("INPUTS_CHANGED: test inputs changed during execution; rerun on stable inputs");
  if (!receiptHasRequiredTests(receipt)) problems.push(receipt.test_summary?.count === 0 ? "NO_PASSING_TESTS: tests failed, were all skipped, or no tests ran" : "NO_TEST_SUMMARY: no supported nonzero test summary; use a real runner such as node --test --test-reporter=tap, Maven test, or pytest. Do not print a synthetic count. On Windows, if Node child-process capture is denied, check whether --experimental-test-isolation=none is supported and suitable for this suite.");
  return problems;
}
function itemDependencies(state2, ids) {
  const found = new Set(ids);
  for (const id of found) for (const dependency of state2.items.find((item) => item.id === id)?.execution_plan?.depends_on ?? []) found.add(dependency);
  return [...found];
}
function groupInputs(state2, group) {
  const dependencies = itemDependencies(state2, group.item_ids).filter((id) => !group.item_ids.includes(id));
  return [.../* @__PURE__ */ new Set([
    ...group.files,
    ...state2.items.filter((item) => dependencies.includes(item.id)).flatMap((item) => item.execution_plan?.files ?? state2.files),
    ...Object.values(state2.verification_groups ?? {}).filter((other) => other.item_ids.some((id) => dependencies.includes(id))).flatMap((other) => other.files)
  ])].sort();
}
function groupPlanningBlockers(state2) {
  if (!state2.verification_version) return [];
  const groups = Object.values(state2.verification_groups ?? {});
  if (!groups.length) return ["plan_verification is required: declare command, files (implementation + tests + relevant configuration), and item_ids before dispatch or verify"];
  const blockers = state2.files.filter((file) => !groups.some((group) => group.files.includes(file))).map((file) => `test coverage is undeclared for ${file}; include it in a verification group`);
  for (const item of state2.items) {
    const owned = groups.filter((group) => group.item_ids.includes(item.id));
    if (!owned.length) blockers.push(`item ${item.id}: plan a verification group for the complete implementation + test unit; do not make its own tests depend on this item being done`);
    else for (const file of item.execution_plan?.files ?? []) if (!owned.some((group) => group.files.includes(file))) blockers.push(`item ${item.id}: its required verification groups do not cover ${file}`);
    for (const group of owned) for (const file of group.files) {
      if (item.execution_plan?.files.includes(file)) continue;
      const owners = state2.items.filter((candidate) => candidate.execution_plan?.files.includes(file));
      if (owners.length && owners.every((owner) => owner.id !== item.id && itemDependencies(state2, [owner.id]).includes(item.id)))
        blockers.push(`item ${item.id}: required check ${group.id} waits for downstream delivery ${file}; merge implementation and its necessary tests into a complete unit, or keep integration checks task-level with item_ids=[]`);
    }
  }
  return blockers;
}
function latestGroupRun(state2, id) {
  const runs = state2.verification_runs ?? [];
  for (let index = runs.length - 1; index >= 0; index--) if (runs[index].group_id === id) return runs[index];
  return void 0;
}
function requiredGroups(state2, itemId) {
  const ids = itemId === void 0 ? void 0 : itemDependencies(state2, [itemId]);
  return Object.values(state2.verification_groups ?? {}).filter((group) => !ids || group.item_ids.some((id) => ids.includes(id)));
}
function groupEvidenceBlockers(state2, hashes, itemId) {
  const problems = groupPlanningBlockers(state2);
  for (const group of requiredGroups(state2, itemId)) {
    const run3 = latestGroupRun(state2, group.id);
    if (!run3) problems.push(`verification group ${group.id}: run verify verification_group=${group.id}`);
    else if (run3.invalidated_reason) problems.push(`verification group ${group.id}: ${run3.invalidated_reason}; rerun verify`);
    else if (run3.plan_key !== group.key) problems.push(`verification group ${group.id}: plan changed; rerun verify`);
    else if (!run3.passed || receiptProblems(run3.receipt).length) problems.push(`verification group ${group.id}: latest run did not pass; ${receiptProblems(run3.receipt).join("; ")}`);
    else if (hashes && run3.receipt.scope_hash !== hashes[group.id]) problems.push(`verification group ${group.id}: stale (inputs changed); rerun verify verification_group=${group.id}`);
  }
  return problems;
}
function verificationKey(state2, itemId) {
  if (!state2.verification_version) return state2.verification.receipt?.finished_at;
  return JSON.stringify(requiredGroups(state2, itemId).sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0).map((group) => [group.id, group.key, latestGroupRun(state2, group.id)?.id]));
}

// src/requirements.ts
