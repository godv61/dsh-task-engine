function scopeHash(state2, root, includeGovernance = false) {
  const entries2 = [...new Set(state2.files)].filter((file) => includeGovernance || !isEngineMeta2(file)).sort().map((file) => {
    const target = import_node_path2.default.resolve(root, file);
    const inside = import_node_path2.default.relative(root, target);
    if (inside.startsWith("..") || import_node_path2.default.isAbsolute(inside)) refuse(`\u4EFB\u52A1\u8303\u56F4\u8DEF\u5F84\u8D8A\u754C: ${file}`);
