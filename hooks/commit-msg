function parseCustomFlow(value) {
  const parsed = customFlowSchema.safeParse(value);
  if (!parsed.success) return { ok: false, problems: parsed.error.issues.map((i) => `${i.path.join(".")}: ${i.message}`) };
  const config2 = parsed.data.config;
  const problems = validateWorkflow(config2);
  if (config2.start_stage !== config2.stages[0]) problems.push("\u8D77\u59CB\u9636\u6BB5\u5FC5\u987B\u662F\u5217\u8868\u4E2D\u7684\u7B2C\u4E00\u4E2A\u9636\u6BB5");
  if (config2.transitions.length !== config2.stages.length - 1 || config2.transitions.some((t, i) => t.from !== config2.stages[i] || t.to !== config2.stages[i + 1])) {
    problems.push("\u7B2C\u4E00\u7248\u53EA\u652F\u6301\u6309\u9636\u6BB5\u5217\u8868\u987A\u5E8F\u9010\u6B65\u6267\u884C\uFF0C\u4E0D\u652F\u6301\u8DF3\u8F6C\u3001\u5206\u652F\u6216\u5FAA\u73AF");
  }
  for (const t of config2.transitions) {
    if (t.requires?.includes("artifacts_present") && !config2.artifacts.some((a) => a.stage === t.from)) problems.push(`${t.from}\uFF1A\u8BF7\u6DFB\u52A0\u4EA7\u7269\u6216\u53D6\u6D88\u300C\u5FC5\u586B\u4EA7\u7269\u300D`);
  }
  const terminal = config2.stages[config2.stages.length - 1];
  if (config2.artifacts.some((a) => a.stage === terminal)) problems.push("\u5B8C\u6210\u9636\u6BB5\u4E0D\u80FD\u8BBE\u7F6E\u5F85\u9A8C\u6536\u4EA7\u7269\uFF0C\u8BF7\u653E\u5230\u524D\u4E00\u4E2A\u9636\u6BB5");
  if (config2.commit.policy !== "manual" && config2.commit.checkpoints.length === 0) problems.push("\u8BF7\u9009\u62E9\u81F3\u5C11\u4E00\u4E2A\u5141\u8BB8\u63D0\u4EA4\u7684\u9636\u6BB5");
  return problems.length ? { ok: false, problems } : { ok: true, value: parsed.data };
}

