    { from: "\u4EA4\u4ED8", to: "\u5BA1\u67E5", requires: [] }
  ],
  artifacts: [
    { stage: "\u9700\u6C42", id: "requirement", name: "\u9700\u6C42\u8BF4\u660E", fields: ["scope"] }
  ],
  commit: {
    policy: "item",
    message_pattern: "^\u3010(\\S+)\u3011\u3010T\\d+\u3011.+",
    message_hint: "\u3010<task_id>\u3011\u3010T1\u3011\u8BF4\u660E \u2014\u2014 \u7B2C\u4E00\u6BB5\u586B\u672C\u4EFB\u52A1 id",
    checkpoints: ["\u4EA4\u4ED8"],
    file_scope: true
  },
  high_risk_requires_verification: false,
  stage_bindings: {
