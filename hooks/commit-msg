function validateWorkflow(config2) {
  const problems = [];
  if (config2.stages.length === 0) problems.push("stages must not be empty");
  const seen = /* @__PURE__ */ new Set();
  for (const stage of config2.stages) {
    if (seen.has(stage)) problems.push(`duplicate stage "${stage}"`);
    seen.add(stage);
  }
  if (!config2.stages.includes(config2.start_stage)) {
    problems.push(`start_stage "${config2.start_stage}" is not in stages`);
  }
  const edges = /* @__PURE__ */ new Set();
  config2.transitions.forEach((transition, index) => {
    if (!config2.stages.includes(transition.from)) {
      problems.push(`transition ${index + 1}: from "${transition.from}" is not a stage`);
    }
    if (!config2.stages.includes(transition.to)) {
      problems.push(`transition ${index + 1}: to "${transition.to}" is not a stage`);
    }
    const edge = `${transition.from}->${transition.to}`;
    if (edges.has(edge)) problems.push(`duplicate transition "${edge}"`);
    edges.add(edge);
    for (const guard2 of transition.requires ?? []) {
      if (!GUARD_NAMES.includes(guard2)) {
        problems.push(`transition ${index + 1}: unknown guard "${String(guard2)}"`);
      }
    }
  });
  const artifactKeys = /* @__PURE__ */ new Set();
  config2.artifacts.forEach((artifact, index) => {
    if (!config2.stages.includes(artifact.stage)) {
      problems.push(`artifact ${index + 1}: stage "${artifact.stage}" is not a stage`);
    }
    const key = artifact.id;
    if (artifactKeys.has(key)) problems.push(`duplicate artifact id "${key}" (ids are unique across all stages)`);
    artifactKeys.add(key);
    if (artifact.fields.length === 0) {
      problems.push(`artifact ${index + 1} ("${artifact.id}"): fields must not be empty`);
    }
    const fieldSet = /* @__PURE__ */ new Set();
    for (const field of artifact.fields) {
      if (fieldSet.has(field)) {
        problems.push(`artifact ${index + 1} ("${artifact.id}"): duplicate field "${field}"`);
      }
      fieldSet.add(field);
    }
  });
  const bindings = config2.stage_bindings ?? {};
  for (const [stage, binding] of Object.entries(bindings)) {
    if (!config2.stages.includes(stage)) {
      problems.push(`stage_bindings: stage "${stage}" is not a stage`);
    }
    for (const skill of binding.skills ?? []) {
      if (typeof skill !== "string" || skill.trim() === "") {
        problems.push(`stage_bindings "${stage}": empty skill name`);
      }
    }
    for (const rule of binding.rules ?? []) {
      if (typeof rule !== "string" || rule.trim() === "") {
        problems.push(`stage_bindings "${stage}": empty rule name`);
      }
    }
  }
  if (!["task", "item", "manual"].includes(config2.commit.policy)) {
    problems.push(`commit.policy "${config2.commit.policy}" is not task|item|manual`);
  }
  for (const checkpoint2 of config2.commit.checkpoints) {
    if (!config2.stages.includes(checkpoint2)) {
      problems.push(`commit.checkpoint "${checkpoint2}" is not a stage`);
    }
  }
  if (config2.commit.message_pattern !== "") {
    try {
      new RegExp(config2.commit.message_pattern);
    } catch {
