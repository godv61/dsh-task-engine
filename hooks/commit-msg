// src/command-words.ts
function commandWords(command) {
  const words = [];
  let word = "", quote = "", active = false;
  for (let i = 0; i < command.length; i++) {
    const char = command[i];
    if (quote) {
      if (char === quote) quote = "";
      else if (quote === '"' && char === "\\" && command[i + 1] === '"') {
        word += '"';
        i++;
      } else word += char;
      active = true;
    } else if (char === '"' || char === "'") {
      quote = char;
      active = true;
    } else if (/\s/u.test(char)) {
      if (active) {
        words.push(word);
        word = "";
        active = false;
      }
    } else {
      word += char;
      active = true;
    }
  }
  if (quote) return void 0;
  if (active) words.push(word);
  return words;
}
function commandName(word) {
  const parts = (word ?? "").replace(/\\/gu, "/").split("/");
  return parts[parts.length - 1].replace(/\.(?:exe|cmd|bat)$/iu, "").toLowerCase();
}

// src/go-test-evidence.ts
function goTestEvidence(command, output) {
  const words = commandWords(command);
  if (!words || commandName(words[0]) !== "go" || words[1] !== "test") return void 0;
  const end = words.findIndex((word, i) => i > 1 && (word === "-args" || word === "--"));
  const args = words.slice(2, end < 0 ? void 0 : end);
  if (!args.some((word) => word === "-json" || word === "-json=true") || args.includes("-json=false")) return { count: null };
  const packages = /* @__PURE__ */ new Map();
  const passed = /* @__PURE__ */ new Map();
  let seen = false;
  for (const line of output.split(/\r?\n/u)) {
    if (!line.trim()) continue;
    if (!line.trimStart().startsWith("{")) {
      if (/^go:/u.test(line)) continue;
      return { count: null };
    }
    let value;
    try {
      value = JSON.parse(line);
    } catch {
      return { count: null };
    }
    if (!value || typeof value !== "object" || Array.isArray(value)) return { count: null };
    const event = value;
    if (event.Action === "build-output" || event.Action === "build-fail") {
      if (event.Action === "build-fail") return { count: 0 };
      continue;
    }
    if (typeof event.Package !== "string" || !event.Package.trim() || !["start", "run", "pause", "cont", "pass", "bench", "fail", "output", "skip"].includes(String(event.Action)) || event.Test !== void 0 && typeof event.Test !== "string") return { count: null };
    seen = true;
    if (event.Action === "fail") return { count: 0 };
    if (!packages.has(event.Package)) packages.set(event.Package, "incomplete");
    if (!event.Test && (event.Action === "pass" || event.Action === "skip")) packages.set(event.Package, event.Action);
    if (event.Test && event.Action === "pass") passed.set(`${event.Package}\0${event.Test}`, event.Package);
  }
  if (!seen || [...packages.values()].some((status) => status === "incomplete")) return { count: null };
  return { count: [...passed.values()].filter((pkg) => packages.get(pkg) === "pass").length };
}

