    "\u5BA1\u67E5": { skills: ["code-review"] }
  }
};
var MINIMAL = {
  stages: ["\u5F00\u53D1", "\u4EA4\u4ED8"],
  start_stage: "\u5F00\u53D1",
  transitions: [
    { from: "\u5F00\u53D1", to: "\u4EA4\u4ED8", requires: ["todos_done"] }
  ],
  artifacts: [],
  commit: {
    policy: "task",
    message_pattern: "",
    message_hint: "\u65E0\u683C\u5F0F\u8981\u6C42",
    checkpoints: ["\u4EA4\u4ED8"],
    file_scope: false
  },
  high_risk_requires_verification: false,
  stage_bindings: {
    "\u5F00\u53D1": { skills: ["code-implement"] },
    "\u4EA4\u4ED8": { skills: ["code-commit"], rules: ["commit-conventions"] }
  }
};
function deriveCapabilities(config2) {
  const caps = [];
  const guards = new Set(config2.transitions.flatMap((t) => t.requires ?? []));
  if (guards.has("verified")) caps.push("verification_gate");
  if (guards.has("review_passed")) caps.push("review_gate");
  if (guards.has("artifacts_present")) caps.push("artifact_gate");
  if (config2.commit.file_scope) caps.push("file_scope");
  return caps;
}
function preset(id, version, label, description, config2) {
  return { id, version, label, description, capabilities: deriveCapabilities(config2), config: config2 };
}
var FLOW_PRESETS = {
  standard: preset("standard", 1, "\u6807\u51C6\u7814\u53D1", "\u9700\u6C42\u8BC4\u5BA1 \u2192 \u8BBE\u8BA1 \u2192 \u5F00\u53D1 \u2192 \u4EA4\u4ED8 \u2192 \u4EE3\u7801\u5BA1\u6838\uFF0C\u542B\u4EA7\u7269\u95E8 + \u786E\u8BA4\u95E8", STANDARD),
  agile: preset("agile", 1, "\u654F\u6377\u8F7B\u91CF", "\u9700\u6C42 \u2192 \u5F00\u53D1 \u2192 \u4EA4\u4ED8 \u2192 \u5BA1\u67E5\uFF0C\u56DB\u9636\u6BB5\u3001\u5C11\u4EA7\u7269", AGILE),
  minimal: preset("minimal", 1, "\u7EAF\u4EE3\u7801", "\u5F00\u53D1 \u2192 \u4EA4\u4ED8\uFF0C\u4E24\u9636\u6BB5\uFF0C\u53EA\u7559\u63D0\u4EA4\u95E8\u7981", MINIMAL)
};
function dedupe(names2) {
  return [...new Set(names2)];
}
function mergeBindings(base, override) {
  if (override === void 0) return base;
  let changed = false;
  const merged = { ...base.stage_bindings };
  for (const [stage, addition] of Object.entries(override)) {
    const existing = merged[stage];
    const skills = dedupe([...existing?.skills ?? [], ...addition.skills ?? []]);
    const rules = dedupe([...existing?.rules ?? [], ...addition.rules ?? []]);
    const binding = {};
    if (skills.length > 0) binding.skills = skills;
    if (rules.length > 0) binding.rules = rules;
    merged[stage] = binding;
    changed = true;
  }
  if (!changed) return base;
  return { ...base, stage_bindings: merged };
}
function resolveFlow(flow, override) {
  if (flow.startsWith("custom:")) {
    const parsed = parseCustomFlow(override?.custom_flow);
    if (!parsed.ok || parsed.value.id !== flow) return { ok: false, code: "INVALID_FLOW", flow, knownFlows: Object.keys(FLOW_PRESETS), problems: parsed.ok ? ["flow \u4E0E custom_flow.id \u4E0D\u4E00\u81F4"] : parsed.problems };
    const custom2 = parsed.value;
    return { ok: true, config: custom2.config, preset: { id: custom2.id, label: custom2.label, description: "\u81EA\u5B9A\u4E49\u987A\u5E8F\u6D41\u7A0B", version: custom2.version, config: custom2.config, capabilities: deriveCapabilities(custom2.config) } };
  }
  const preset2 = FLOW_PRESETS[flow];
  if (preset2 === void 0) {
    return { ok: false, code: "UNKNOWN_FLOW", flow, knownFlows: Object.keys(FLOW_PRESETS) };
  }
  return { ok: true, config: mergeBindings(preset2.config, override?.stage_bindings), preset: preset2 };
}

// src/snapshot.ts
var import_node_crypto = require("node:crypto");
function hashText(text) {
  return (0, import_node_crypto.createHash)("sha256").update(text).digest("hex");
}
function hashConfig(config2) {
  return hashText(JSON.stringify(config2));
}

// src/project.ts
var TYPE_MARKERS = {
  node: ["package.json"],
  java: ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle"],
  python: ["pyproject.toml", "requirements.txt", "setup.py"],
  go: ["go.mod"],
  rust: ["Cargo.toml"]
};
var DEFAULT_RISK_POLICY = {
  // `.dsh/task-*.json` and `.dsh/eng.json` are protected by the snapshot hash and
  // the engine-meta exemption, not by this list; `.dsh/rules` / `.dsh/skills`
  // hold regular project content and stay committable by normal tasks.
  sensitive_paths: [".git", ".env", ".credentials.yaml", "credentials", "secrets"],
  risky_operations: ["D", "T"]
};
var ALL_MARKERS = Object.values(TYPE_MARKERS).flat();

// src/hook.ts
var messageFile = process.argv[2];
function refuse(reason) {
  console.error("");
  console.error("dsh-task-engine \u63D0\u4EA4\u95E8\u7981\u62D2\u7EDD: " + reason);
  console.error("\u8BF7\u5148\u7528 dev_task \u8D70\u5B8C\u524D\u7F6E\u9636\u6BB5\uFF08\u6216\u4FEE\u6B63\u63D0\u4EA4\u6D88\u606F\uFF09\uFF0C\u518D\u63D0\u4EA4\u3002");
  console.error("");
  process.exit(1);
}
function readJson(abs) {
  try {
    return JSON.parse(import_node_fs.default.readFileSync(abs, "utf8"));
  } catch {
    return void 0;
  }
}
function normalizeTask(task) {
  return {
    schema: 1,
    id: String(task.id ?? ""),
    title: String(task.title ?? ""),
    branch: String(task.branch ?? ""),
    work_size: task.work_size ?? "standard",
    risk_level: task.risk_level ?? "standard",
    stage: String(task.stage ?? ""),
    ...task.stage_confirmations !== void 0 ? { stage_confirmations: task.stage_confirmations } : {},
    requirement_confirmed: task.requirement_confirmed === true,
    solution_confirmed: task.solution_confirmed === true,
    items: Array.isArray(task.items) ? task.items : [],
    verification: task.verification ?? { passed: false, evidence: [] },
    review: task.review ?? { outcome: "pending" },
    artifacts: task.artifacts ?? {},
    files: Array.isArray(task.files) ? task.files : [],
    commits: Array.isArray(task.commits) ? task.commits : [],
    ...task.flow !== void 0 ? { flow: task.flow } : {}
  };
}
function loadTasks() {
  const dir = import_node_path.default.join(process.cwd(), ".dsh");
  if (!import_node_fs.default.existsSync(dir)) return [];
  const out = [];
  const names2 = import_node_fs.default.readdirSync(dir).filter((name2) => name2.startsWith("task-") && name2.endsWith(".json"));
  for (const name2 of names2) {
    const json = readJson(import_node_path.default.join(dir, name2));
    if (json !== void 0 && json.id !== void 0) out.push({ file: import_node_path.default.join(dir, name2), task: normalizeTask(json) });
  }
  return out;
}
function currentBranch() {
  try {
    return (0, import_node_child_process.execSync)("git rev-parse --abbrev-ref HEAD", { encoding: "utf8" }).trim();
  } catch {
    return "";
  }
}
function stagedEntries() {
  try {
    const raw = (0, import_node_child_process.execSync)("git -c core.quotePath=false diff --cached --name-status -z --diff-filter=ACMRDT", { encoding: "utf8" });
    const parts = raw.split("\0");
    const entries2 = [];
    let i = 0;
    while (i < parts.length) {
      const status = parts[i];
      if (status === void 0 || status === "") {
        i++;
        continue;
      }
      if (status.startsWith("R") || status.startsWith("C")) {
        const from = parts[i + 1];
        const to = parts[i + 2];
        if (from !== void 0 && from !== "") entries2.push({ status, path: from });
        if (to !== void 0 && to !== "") entries2.push({ status, path: to });
        i += 3;
      } else {
        const path2 = parts[i + 1];
        if (path2 !== void 0 && path2 !== "") entries2.push({ status, path: path2 });
        i += 2;
      }
    }
    return entries2;
  } catch {
    return [];
  }
}
function fileMtime(file) {
  try {
    return import_node_fs.default.statSync(file).mtimeMs;
  } catch {
    return 0;
  }
}
function pickTask(tasks2, branch) {
  if (tasks2.length === 0) return void 0;
  const byBranch = tasks2.find(({ task }) => task.branch === branch);
  if (byBranch) return byBranch.task;
  if (tasks2.length === 1) return tasks2[0].task;
  const sorted = [...tasks2].sort((a, b) => fileMtime(b.file) - fileMtime(a.file));
  return sorted[0].task;
}
function readCommitMessage(file) {
  return import_node_fs.default.readFileSync(file, "utf8").split("\n").filter((line) => !line.startsWith("#")).join("\n").trim();
}
function extractTaskId(message2) {
  const match = /^【([^【】\s]+)】/.exec(message2);
  return match ? match[1] : void 0;
}
function isEngineMeta2(file) {
  return /^\.dsh\/(task-[^/]+\.json|eng\.json)$/.test(file);
}
function riskyPaths(entries2) {
  return entries2.filter((entry) => !isEngineMeta2(entry.path)).filter((entry) => DEFAULT_RISK_POLICY.sensitive_paths.some((prefix) => entry.path === prefix || entry.path.startsWith(`${prefix}/`))).map((entry) => entry.path);
}
function riskVerified(state2) {
  const receipt = state2.verification.receipt;
  return state2.risk_level === "high_risk" && receipt !== void 0 && receipt.exit_code === 0 && !receipt.timed_out && !receipt.aborted;
}
function defaultConfig() {
  const resolved = resolveFlow("standard");
  if (!resolved.ok) throw new Error('built-in "standard" preset is missing');
  return resolved.config;
}
function loadWorkflow(parsed) {
  if (parsed === void 0) return defaultConfig();
  const flow = parsed?.flow;
  if (typeof flow !== "string" || flow.trim() === "") {
    refuse('\u9879\u76EE .dsh/eng.json \u7F3A "flow" \u5B57\u6BB5\u2014\u2014\u8BBE\u4E3A standard|agile|minimal\uFF0C\u6216\u5220\u9664\u8BE5\u6587\u4EF6');
  }
  const override = typeof parsed.stage_bindings === "object" && parsed.stage_bindings !== null && !Array.isArray(parsed.stage_bindings) ? { stage_bindings: parsed.stage_bindings } : void 0;
  const resolved = resolveFlow(flow, { ...override, custom_flow: parsed.custom_flow });
  if (!resolved.ok) {
    refuse(resolved.problems?.join("; ") ?? `\u672A\u77E5\u6D41\u7A0B "${resolved.flow}"\uFF08\u5DF2\u77E5\u6D41\u7A0B\uFF1A${resolved.knownFlows.join("\u3001")}\uFF09`);
  }
  return resolved.config;
}
function loadProjectWorkflow() {
  const cwd = process.cwd();
  const configPath = import_node_path.default.join(cwd, ".dsh", "eng.json");
  if (import_node_fs.default.existsSync(configPath)) {
    let raw = "";
    try {
      raw = import_node_fs.default.readFileSync(configPath, "utf8");
    } catch {
      raw = "";
    }
    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch (error) {
      refuse("invalid JSON in .dsh/eng.json: " + (error instanceof Error ? error.message : String(error)));
    }
    return loadWorkflow(parsed);
  } else {
    return loadWorkflow(void 0);
  }
}
if (!messageFile) {
  process.exit(0);
}
var message = readCommitMessage(messageFile);
var tasks = loadTasks();
var taskId = extractTaskId(message);
var state;
if (taskId !== void 0) {
  const found = tasks.find(({ task }) => task.id === taskId);
  if (!found) {
    refuse(`\u63D0\u4EA4\u6D88\u606F\u91CC\u7684\u4EFB\u52A1 id "${taskId}" \u627E\u4E0D\u5230\u5BF9\u5E94\u7684\u4EFB\u52A1\u8BB0\u5F55\uFF08.dsh/task-<id>.json\uFF09`);
  }
  state = found.task;
} else {
  const matching = tasks.filter(({ task }) => task.flow && taskIdFromMessage(message, task.flow.config) === task.id);
  if (matching.length > 1) refuse("\u63D0\u4EA4\u6D88\u606F\u5339\u914D\u591A\u4E2A\u4EFB\u52A1\uFF0C\u8BF7\u4F7F\u7528\u552F\u4E00\u4EFB\u52A1 ID");
  state = matching[0]?.task ?? pickTask(tasks, currentBranch());
}
if (!state) {
  refuse("\u6CA1\u6709\u627E\u5230 dev_task \u4EFB\u52A1\u8BB0\u5F55\uFF08.dsh/task-*.json\uFF09\u2014\u2014\u8BF7\u5148 dev_task operation=create \u5EFA\u7ACB\u4EFB\u52A1");
}
if (state.flow?.hash !== void 0 && hashConfig(state.flow.config) !== state.flow.hash) {
  refuse(`\u4EFB\u52A1 ${state.id} \u7684\u6D41\u7A0B\u5FEB\u7167 hash \u4E0D\u5339\u914D\u2014\u2014task \u8BB0\u5F55\u5728\u521B\u5EFA\u540E\u88AB\u6539\u52A8\u8FC7\uFF0C\u4FEE\u590D\u6216\u91CD\u5EFA\u4EFB\u52A1\u540E\u518D\u63D0\u4EA4`);
}
var config = state.flow?.config ?? loadProjectWorkflow();
var messageTaskId = taskIdFromMessage(message, config);
if (messageTaskId !== void 0 && messageTaskId !== state.id) refuse(`\u63D0\u4EA4\u6D88\u606F\u6307\u5B9A\u4EFB\u52A1 ${messageTaskId}\uFF0C\u4E0E\u5F53\u524D\u4EFB\u52A1 ${state.id} \u4E0D\u4E00\u81F4`);
var verdict = validateCommitMessage(message, config);
if (!verdict.ok) {
  refuse(verdict.errors?.[0] ?? "commit summary does not match the configured pattern");
}
var checkpoint = commitCheckpoint(state, config, true);
if (!checkpoint.allowed) {
  refuse((checkpoint.reason ?? "commit checkpoint rejected") + "\uFF08\u5F53\u524D\u9636\u6BB5: " + state.stage + "\uFF09");
}
var entries = stagedEntries();
var scope = checkFileScope(state, entries.map((entry) => entry.path), config);
if (!scope.ok) {
  if (scope.noScope) {
    refuse("\u4EFB\u52A1\u6CA1\u6709\u58F0\u660E\u6587\u4EF6\u8303\u56F4\uFF08files \u4E3A\u7A7A\uFF09\u2014\u2014\u5148\u7528 dev_task operation=scope \u58F0\u660E\u672C\u4EFB\u52A1\u6D89\u53CA\u7684\u6587\u4EF6");
  }
  const described = scope.outside.map((outside) => {
    const entry = entries.find((candidate) => candidate.path === outside);
    return entry === void 0 ? outside : `${entry.status}	${outside}`;
  });
  refuse("\u63D0\u4EA4\u4E86\u4EFB\u52A1\u8303\u56F4\u4E4B\u5916\u7684\u6587\u4EF6: " + described.join(", "));
}
var sensitive = riskyPaths(entries);
if (sensitive.length > 0 && !riskVerified(state)) {
  refuse(
    "\u63D0\u4EA4\u89E6\u53CA\u654F\u611F\u8DEF\u5F84: " + sensitive.join(", ") + " \u2014 \u8FD9\u7C7B\u53D8\u66F4\u8981\u6C42\u4EFB\u52A1\u58F0\u660E\u4E3A high_risk\uFF0C\u4E14\u9A8C\u8BC1\u5FC5\u987B\u662F\u771F\u5B9E\u547D\u4EE4\u56DE\u6267\uFF08exit 0\uFF09"
  );
}
process.exit(0);
