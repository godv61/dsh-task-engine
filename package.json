{
  "name": "@godv61/dsh-task-engine",
  "version": "0.27.0",
  "description": "Workflow engine for DeepSeek Harness: a `dev_task` tool that hard-gates stage transitions and commit scope/message, per-node skill bindings with progressive disclosure, and a workbench to configure flows and mount skills. A preset is a flow SKELETON — state control only — and one reasonable engineering setup is offered separately for explicit adoption; which skills run, which rules they follow and what a commit message must look like stay the user's decisions.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-task-engine-enable": "preset/enable.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./defaults/eng.json": "./defaults/eng.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "defaults/eng.json",
    "hooks/**",
    "skills/**",
    "rules/**",
    "preset/**",
    "scripts/**",
    "docs/**",
    "README.md",
    ".p0-test.mjs",
    ".acceptance.mjs",
    ".hook-consistency.mjs",
    ".resource-test.mjs",
    ".workflow-test.mjs",
    ".hook-test.mjs",
    ".preset-test.mjs",
    ".assessment-batch1.mjs",
    ".e2e-presets.mjs",
    ".revision-test.mjs",
    ".freeze-test.mjs",
    ".enforce-test.mjs",
    ".evidence-test.mjs",
    ".roundtrip-test.mjs",
    ".filter-test.mjs"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-client.mjs && node build-hook.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node .p0-test.mjs && node .acceptance.mjs && node .hook-consistency.mjs && node --test .resource-test.mjs .workflow-test.mjs .hook-test.mjs .preset-test.mjs .assessment-batch1.mjs .e2e-presets.mjs .revision-test.mjs .freeze-test.mjs .enforce-test.mjs .evidence-test.mjs .roundtrip-test.mjs .filter-test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:dsh": "node scripts/verify-dsh-compat.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1 || ^0.1.3-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.3-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.1.3-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1 || ^0.1.3-alpha.1 || ^0.1.6-alpha.2 || ^0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godv61/dsh-task-engine.git"
  },
  "homepage": "https://github.com/godv61/dsh-task-engine#readme",
  "bugs": {
    "url": "https://github.com/godv61/dsh-task-engine/issues"
  }
}
